# Frido 部署配置 - 复制为 .env 后修改

# 服务器公网 IP 或域名
PUBLIC_HOST=192.144.232.160

# MySQL（xiaozhi 全模块）
MYSQL_ROOT_PASSWORD=frido_mysql_2026
MYSQL_DATABASE=xiaozhi_esp32_server

# Frido 业务 API
FRIDGE_DB_PATH=/data/fridge.db
VISION_EXPLAIN_URL=http://xiaozhi-esp32-server:8003/mcp/vision/explain
VISION_TOKEN=
FRIDO_DEVICE_ID=frido-fridge-001

# 微信小程序（apps/miniprogram/project.config.json 也需配置）
WX_APPID=
WX_SECRET=

# AI 模型密钥（在智控台 http://PUBLIC_HOST:8002 配置，或写入 upstream data/.config.yaml）
# ZHIPU_API_KEY=
