.chat { display: flex; flex-direction: column; height: 100vh; }
.messages { flex: 1; padding: 24rpx; }
.msg { padding: 16rpx 24rpx; margin-bottom: 16rpx; border-radius: 12rpx; max-width: 80%; }
.user { background: #1a73e8; color: #fff; margin-left: auto; }
.assistant { background: #fff; }
.input-bar { display: flex; padding: 16rpx; background: #fff; gap: 16rpx; }
.input-bar input { flex: 1; background: #f5f5f5; padding: 12rpx; border-radius: 8rpx; }
